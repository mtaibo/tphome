# -------  WiFi (firmware)  -------

WIFI_SSID=
WIFI_PASS=

# -------  MQTT  -------

MQTT_IP=             # LAN IP of the Pi — used by the firmware to reach the broker
MQTT_BROKER=mosquitto  # Docker service name — used by the API inside the container
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# -------  API  -------

DATABASE_URL=sqlite:////app/storage/tphome.db  # maps to tphome/db/ on the host
